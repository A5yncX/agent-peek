{
  "name": "@asyncx/agent-peek",
  "version": "0.5.0",
  "description": "Read-only progress snapshots for Pi, Claude Code, and Codex CLI sessions",
  "type": "module",
  "license": "MIT",
  "author": "A5yncX",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/A5yncX/agent-peek.git"
  },
  "homepage": "https://github.com/A5yncX/agent-peek#readme",
  "bugs": {
    "url": "https://github.com/A5yncX/agent-peek/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "agent",
    "progress",
    "claude-code",
    "codex"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "index.ts",
    "core.ts",
    "presence.ts",
    "adapters.ts",
    "i18n.ts",
    "card.ts",
    "bin",
    "hooks",
    "commands",
    "codex-skills",
    "docs",
    ".codex-plugin",
    ".claude-plugin",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "bin": {
    "agent-peek": "bin/agent-peek.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "npm test && npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
